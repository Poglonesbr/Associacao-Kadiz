generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  COORDENADOR
  SECRETARIA
  PROFESSOR
  PSICOLOGO
  ASSISTENTE_SOCIAL
  FINANCEIRO
}

enum PoloType {
  SEDE
  ESCOLA_POLO
}

enum Shift {
  MANHA
  TARDE
  NOITE
}

enum Modality {
  FUTEBOL
  FUTSAL
  XADREZ
  REFORCO_ESCOLAR
  HORTA
  OUTRO
}

enum Vinculo {
  PARTICULAR
  PROJETO_SOCIAL
}

enum AlunoStatus {
  ATIVO
  INATIVO
  LISTA_ESPERA
  DESLIGADO
}

enum SchoolShift {
  MATUTINO
  VESPERTINO
}

enum DominantFoot {
  DESTRO
  CANHOTO
  AMBIDESTRO
}

enum GuardianRelation {
  MAE
  PAI
  AVO
  TIO
  IRMAO
  TUTOR
  OUTRO
}

enum HousingType {
  PROPRIA
  ALUGADA
  CEDIDA
  OCUPACAO
  OUTRA
}

enum StudentDocumentType {
  FICHA_CADASTRAL
  RG
  COMPROVANTE_RESIDENCIA
  ATESTADO_MEDICO
  CARTEIRA_VACINACAO
  CARTAO_SUS
  BOLETIM_ESCOLAR
  ELETROCARDIOGRAMA
  FOTO
  TERMO_RESPONSABILIDADE
}

enum DocumentStatus {
  PENDENTE
  ENTREGUE
  APROVADO
  REJEITADO
}

enum AttendanceStatus {
  PRESENTE
  FALTA
  FALTA_JUSTIFICADA
}

enum Area {
  PSICOLOGIA
  SERVICO_SOCIAL
}

enum AtendimentoStatus {
  AGENDADO
  REALIZADO
  FALTOU
  CANCELADO
}

enum AtendimentoType {
  INDIVIDUAL
  GRUPOTERAPIA
  FAMILIAR
  RODA_CONVERSA
  APOIO_COMPETICAO
  OFICINA_FAMILIAS
  ESCUTA_QUALIFICADA
  ACOLHIMENTO
  VISITA_DOMICILIAR
  ORIENTACAO_FAMILIAR
  ARTICULACAO_REDE
}

enum ReferralDestination {
  CRAS
  CREAS
  CAPSI
  UBS
  CONSELHO_TUTELAR
  ESCOLA
  PSICOLOGIA_INTERNA
  SERVICO_SOCIAL_INTERNO
  OUTRO
}

enum ReferralStatus {
  AGUARDANDO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
}

enum AtendidoStatus {
  ATIVO
  ENCERRADO
}

enum AtendidoOrigin {
  DEMANDA_ESPONTANEA
  ESCOLA
  CONSELHO_TUTELAR
  CRAS
  EQUIPE_KADIZ
  OUTRO
}

enum AtendidoExitType {
  OBJETIVOS_ALCANCADOS
  TRANSFERENCIA_REDE
  EVASAO
  DESLIGAMENTO
}

enum PiaAreaType {
  DOCUMENTACAO
  SAUDE
  SAUDE_MENTAL
  EDUCACAO
  CONVIVENCIA_FAMILIAR
  ASSISTENCIA_SOCIAL
  MORADIA
  TRABALHO_RENDA_FAMILIA
  PROTECAO_DIREITOS
  OUTRAS
}

enum PiaAreaStatus {
  SEM_DEMANDA
  IDENTIFICADA
  EM_ACOMPANHAMENTO
  RESOLVIDA
}

enum PiaGoalEvaluation {
  NAO_INICIADA
  EM_ANDAMENTO
  ALCANCADA
  NAO_ALCANCADA
}

enum SignatureSignerType {
  USUARIO
  PROFISSIONAL
}

enum AccessAction {
  VIEW
  CREATE
  UPDATE
  GRANT
  REVOKE
}

enum StockCategory {
  UNIFORME
  DOACAO
  MATERIAL_ESPORTIVO
  ALIMENTO
  OUTRO
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
}

enum InvoiceStatus {
  PENDENTE
  PAGO
  CANCELADO
}

enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO
  BOLETO
  TRANSFERENCIA
}

enum FinanceType {
  RECEITA
  DESPESA
}

enum TaskPriority {
  BAIXA
  MEDIA
  ALTA
}

enum TaskStatus {
  ABERTA
  EM_ANDAMENTO
  CONCLUIDA
}

enum EventCategory {
  TREINO
  JOGO
  EVENTO
  REUNIAO
  OFICINA_FAMILIAS
  SABADO_EM_FAMILIA
  OUTRO
}

model User {
  id                    String              @id @default(cuid())
  name                  String
  email                 String              @unique
  passwordHash          String
  phone                 String?
  professionalRegistry  String?
  jobTitle              String?
  role                  Role
  active                Boolean             @default(true)
  accessPsicologia      Boolean             @default(false)
  accessServicoSocial   Boolean             @default(false)
  createdAt             DateTime            @default(now())
  turmas                Turma[]             @relation("TurmaProfessor")
  documentsReviewed     StudentDocument[]   @relation("DocumentReviewer")
  attendanceSessions    AttendanceSession[] @relation("AttendanceTakenBy")
  accessLogs            AccessLog[]
  tasksAssigned         Task[]              @relation("TaskAssignee")
  tasksCreated          Task[]              @relation("TaskCreator")
  financeEntries        FinanceEntry[]
  stockMovements        StockMovement[]
  atendidosResponsaveis Atendido[]          @relation("AtendidoResponsible")
  atendidosCreated      Atendido[]          @relation("AtendidoCreator")
  atendimentos          Atendimento[]       @relation("AtendimentoProfessional")
  evolucoesAuthored     Evolucao[]          @relation("EvolucaoAuthor")
  piaReviewsAuthored    PiaReview[]         @relation("PiaReviewAuthor")
  piaSignatures         PiaSignature[]      @relation("SignatureUser")
  atendidoChanges       AtendidoChange[]
}

model Polo {
  id        String   @id @default(cuid())
  name      String
  type      PoloType
  address   String?
  active    Boolean  @default(true)
  turmas    Turma[]
  alunos    Aluno[]
  events    Event[]
  createdAt DateTime @default(now())
}

model Turma {
  id          String              @id @default(cuid())
  name        String
  poloId      String
  professorId String?
  shift       Shift
  weekdays    String[]            @default([])
  startTime   String
  endTime     String
  modality    Modality
  active      Boolean             @default(true)
  polo        Polo                @relation(fields: [poloId], references: [id], onDelete: Cascade)
  professor   User?               @relation("TurmaProfessor", fields: [professorId], references: [id], onDelete: SetNull)
  alunos      Aluno[]
  sessions    AttendanceSession[]
  createdAt   DateTime            @default(now())

  @@index([poloId])
  @@index([professorId])
}

model Aluno {
  id                   String             @id @default(cuid())
  matricula            String             @unique
  vinculo              Vinculo
  status               AlunoStatus        @default(ATIVO)
  poloId               String
  turmaId              String?
  enrolledAt           DateTime           @default(now())
  startDate            DateTime?
  fullName             String
  birthDate            DateTime
  cpf                  String?
  rg                   String?
  sex                  String?
  ethnicity            String?
  naturalidade         String?
  address              String?
  addressNumber        String?
  neighborhood         String?
  city                 String?
  school               String?
  schoolGrade          String?
  schoolShift          SchoolShift?
  position             String?
  shirtNumber          String?
  dominantFoot         DominantFoot?
  weekdays             String[]           @default([])
  guardianName         String
  guardianRelation     GuardianRelation
  householdSize        Int?
  guardianPhone        String?
  guardianEmail        String?
  guardianCpf          String?
  motherName           String?
  motherJob            String?
  motherPhone          String?
  fatherName           String?
  fatherJob            String?
  fatherPhone          String?
  otherGuardian        String?
  hasHealthPlan        Boolean?
  bloodType            String?
  chronicDisease       String?
  continuousMedication String?
  allergies            String?
  foodRestrictions     String?
  surgeries            String?
  psychFollowUp        Boolean            @default(false)
  difficulties         String[]           @default([])
  difficultiesOther    String?
  susCard              String?
  medicalNotes         String?
  emergencyName        String?
  emergencyRelation    String?
  emergencyPhone       String?
  authTrips            Boolean            @default(false)
  authImage            Boolean            @default(false)
  authTermsAccepted    Boolean            @default(false)
  monthlyFee           Decimal?           @db.Decimal(10, 2)
  billingDay           Int?
  invoiceName          String?
  invoiceCpf           String?
  invoiceEmail         String?
  hasUniform           Boolean            @default(false)
  exitDate             DateTime?
  exitReason           String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  polo                 Polo               @relation(fields: [poloId], references: [id])
  turma                Turma?             @relation(fields: [turmaId], references: [id], onDelete: SetNull)
  documents            StudentDocument[]
  attendanceRecords    AttendanceRecord[]
  stockMovements       StockMovement[]
  invoices             Invoice[]
  atendido             Atendido?

  @@index([fullName])
  @@index([poloId, turmaId, vinculo, status])
}

model Atendido {
  id                   String            @id @default(cuid())
  alunoId              String            @unique
  status               AtendidoStatus    @default(ATIVO)
  ingressoDate         DateTime          @db.Date
  origem               AtendidoOrigin?
  responsavelTecnicoId String?
  nextReviewDate       DateTime?         @db.Date
  closeDate            DateTime?         @db.Date
  closeType            AtendidoExitType?
  closeReason          String?           @db.Text
  familyIncome         Decimal?          @db.Decimal(10, 2)
  incomeSources        String?           @db.Text
  nis                  String?
  bolsaFamilia         Boolean           @default(false)
  otherBenefits        String?           @db.Text
  crasReference        String?
  conselhoTutelar      Boolean           @default(false)
  conselhoTutelarNotes String?           @db.Text
  housingType          HousingType?
  housingNotes         String?           @db.Text
  vulnerabilities      String[]          @default([])
  currentSituation     String?           @db.Text
  familyHistory        String?           @db.Text
  potentialities       String?           @db.Text
  createdById          String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  aluno                Aluno             @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  responsavelTecnico   User?             @relation("AtendidoResponsible", fields: [responsavelTecnicoId], references: [id], onDelete: SetNull)
  createdBy            User              @relation("AtendidoCreator", fields: [createdById], references: [id], onDelete: Restrict)
  areas                PiaArea[]
  goals                PiaGoal[]
  encaminhamentos      Encaminhamento[]
  atendimentos         Atendimento[]
  evolucoes            Evolucao[]
  reviews              PiaReview[]
  signatures           PiaSignature[]
  changes              AtendidoChange[]
  pdfCopies            PiaPdf[]

  @@index([status, nextReviewDate])
  @@index([responsavelTecnicoId])
}

model PiaArea {
  id               String        @id @default(cuid())
  atendidoId       String
  area             PiaAreaType
  necessidade      String?       @db.Text
  acoes            String?       @db.Text
  prazoResponsavel String?       @db.Text
  status           PiaAreaStatus @default(SEM_DEMANDA)
  atendido         Atendido      @relation(fields: [atendidoId], references: [id], onDelete: Cascade)

  @@unique([atendidoId, area])
}

model PiaGoal {
  id         String            @id @default(cuid())
  atendidoId String
  objetivo   String
  meta       String?           @db.Text
  acoes      String?           @db.Text
  prazo      DateTime?         @db.Date
  avaliacao  PiaGoalEvaluation @default(NAO_INICIADA)
  order      Int               @default(0)
  atendido   Atendido          @relation(fields: [atendidoId], references: [id], onDelete: Cascade)

  @@index([atendidoId, order])
}

model Encaminhamento {
  id                String              @id @default(cuid())
  atendidoId        String
  area              Area
  destination       ReferralDestination
  destinationDetail String?
  reason            String              @db.Text
  date              DateTime            @db.Date
  returnNotes       String?             @db.Text
  status            ReferralStatus      @default(AGUARDANDO)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  atendido          Atendido            @relation(fields: [atendidoId], references: [id], onDelete: Cascade)

  @@index([atendidoId, date])
  @@index([area, status, date])
}

model Atendimento {
  id             String            @id @default(cuid())
  area           Area
  type           AtendimentoType
  date           DateTime          @db.Date
  startTime      String?
  durationMin    Int?
  status         AtendimentoStatus @default(AGENDADO)
  summary        String?           @db.Text
  professionalId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  atendidos      Atendido[]
  professional   User              @relation("AtendimentoProfessional", fields: [professionalId], references: [id], onDelete: Restrict)

  @@index([area, date, status])
  @@index([professionalId, date])
}

model Evolucao {
  id         String   @id @default(cuid())
  atendidoId String
  area       Area
  authorId   String
  date       DateTime @db.Date
  content    String   @db.Text
  newGoals   String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  atendido   Atendido @relation(fields: [atendidoId], references: [id], onDelete: Cascade)
  author     User     @relation("EvolucaoAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([atendidoId, date])
  @@index([area, date])
}

model PiaReview {
  id          String   @id @default(cuid())
  atendidoId  String
  date        DateTime @db.Date
  changes     String   @db.Text
  newGoals    String?  @db.Text
  responsavel String?
  authorId    String
  createdAt   DateTime @default(now())
  atendido    Atendido @relation(fields: [atendidoId], references: [id], onDelete: Cascade)
  author      User     @relation("PiaReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([atendidoId, date])
}

model PiaSignature {
  id           String              @id @default(cuid())
  atendidoId   String
  signerType   SignatureSignerType
  signerName   String
  userId       String?
  imageDataUrl String              @db.Text
  signedAt     DateTime            @default(now())
  atendido     Atendido            @relation(fields: [atendidoId], references: [id], onDelete: Cascade)
  user         User?               @relation("SignatureUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([atendidoId, signedAt])
}

model AtendidoChange {
  id         String   @id @default(cuid())
  atendidoId String
  userId     String?
  section    String
  field      String
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  createdAt  DateTime @default(now())
  atendido   Atendido @relation(fields: [atendidoId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([atendidoId, createdAt])
}

model PiaPdf {
  id         String   @id @default(cuid())
  atendidoId String
  filePath   String
  createdAt  DateTime @default(now())
  atendido   Atendido @relation(fields: [atendidoId], references: [id], onDelete: Cascade)

  @@index([atendidoId, createdAt])
}

model StudentDocument {
  id           String              @id @default(cuid())
  alunoId      String
  type         StudentDocumentType
  status       DocumentStatus      @default(PENDENTE)
  filePath     String?
  fileName     String?
  deliveredAt  DateTime?
  validUntil   DateTime?
  notes        String?
  reviewedById String?
  aluno        Aluno               @relation(fields: [alunoId], references: [id], onDelete: Cascade)
  reviewedBy   User?               @relation("DocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([alunoId, type])
  @@index([status, type])
}

model AttendanceSession {
  id        String             @id @default(cuid())
  turmaId   String
  date      DateTime
  takenById String
  notes     String?
  turma     Turma              @relation(fields: [turmaId], references: [id], onDelete: Cascade)
  takenBy   User               @relation("AttendanceTakenBy", fields: [takenById], references: [id])
  records   AttendanceRecord[]

  @@unique([turmaId, date])
}

model AttendanceRecord {
  id            String            @id @default(cuid())
  sessionId     String
  alunoId       String
  status        AttendanceStatus
  justification String?
  session       AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  aluno         Aluno             @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([sessionId, alunoId])
  @@index([alunoId, status])
}

model AccessLog {
  id         String       @id @default(cuid())
  userId     String
  action     AccessAction
  resource   String
  resourceId String?
  alunoId    String?
  createdAt  DateTime     @default(now())
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([resource, createdAt])
  @@index([alunoId, createdAt])
}

model StockItem {
  id          String          @id @default(cuid())
  name        String
  category    StockCategory
  size        String?
  unit        String          @default("un")
  quantity    Int             @default(0)
  minQuantity Int             @default(0)
  notes       String?
  movements   StockMovement[]
  createdAt   DateTime        @default(now())
}

model StockMovement {
  id       String            @id @default(cuid())
  itemId   String
  type     StockMovementType
  quantity Int
  alunoId  String?
  donor    String?
  reason   String?
  userId   String
  date     DateTime          @default(now())
  item     StockItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  aluno    Aluno?            @relation(fields: [alunoId], references: [id], onDelete: SetNull)
  user     User              @relation(fields: [userId], references: [id])

  @@index([itemId, date])
}

model Invoice {
  id             String         @id @default(cuid())
  alunoId        String
  referenceMonth String
  amount         Decimal        @db.Decimal(10, 2)
  dueDate        DateTime
  status         InvoiceStatus  @default(PENDENTE)
  paidAt         DateTime?
  paymentMethod  PaymentMethod?
  notes          String?
  aluno          Aluno          @relation(fields: [alunoId], references: [id], onDelete: Cascade)

  @@unique([alunoId, referenceMonth])
  @@index([status, dueDate])
}

model FinanceEntry {
  id          String      @id @default(cuid())
  type        FinanceType
  category    String
  description String
  amount      Decimal     @db.Decimal(10, 2)
  date        DateTime    @default(now())
  source      String?
  userId      String
  user        User        @relation(fields: [userId], references: [id])

  @@index([date, type])
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  category    String?
  priority    TaskPriority @default(MEDIA)
  status      TaskStatus   @default(ABERTA)
  dueDate     DateTime?
  assigneeId  String?
  createdById String
  assignee    User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User         @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
}

model Event {
  id          String        @id @default(cuid())
  title       String
  description String?
  start       DateTime
  end         DateTime?
  allDay      Boolean       @default(false)
  category    EventCategory @default(OUTRO)
  poloId      String?
  polo        Polo?         @relation(fields: [poloId], references: [id], onDelete: SetNull)
}

model Snack {
  id        String   @id @default(cuid())
  date      DateTime
  time      String
  menu      String
  location  String
  notes     String?
  createdAt DateTime @default(now())
}
